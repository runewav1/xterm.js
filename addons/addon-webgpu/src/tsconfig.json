{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2021",
    "lib": ["dom", "es2021"],
    "rootDir": ".",
    "outDir": "../out",
    "sourceMap": true,
    "removeComments": true,
    "paths": {
      "common/*": ["../../../src/common/*"],
      "browser/*": ["../../../src/browser/*"],
      "@partty/addon-webgpu": ["../typings/addon-webgpu.d.ts"]
    },
    "strict": true,
    "experimentalDecorators": true,
    "types": ["mocha"]
  },
  "include": ["./**/*", "../../../typings/xterm.d.ts"],
  "references": [{ "path": "../../../src/common" }, { "path": "../../../src/browser" }]
}

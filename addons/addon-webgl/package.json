	"author": {
		"name": "The xterm.js authors",
		"url": "https://xtermjs.org/"
	},
	"main": "lib/addon-webgl.js",
	"module": "lib/addon-webgl.mjs",
	"types": "typings/addon-webgl.d.ts",
